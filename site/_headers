/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Language: zh-CN
  Cache-Control: public, max-age=0, must-revalidate

/style.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800, immutable

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/og-en.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

# 媒体体积已按显示尺寸优化（无损 WebP）。文件名不带内容哈希，因此不用 immutable：
# 1 天 TTL + 回源期间先给旧内容，避免更新后的素材被浏览器冻结。
# 注意：该规则对 404 响应也生效，新增媒体后若在资产上线前被请求，边缘可能缓存 404 一天；
# 部署后建议用带查询串的 URL 验证一次，必要时清除缓存。
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/en/*
  ! Content-Language
  Content-Language: en
