{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch",
  "version": "0.1.1",
  "identifier": "cn.bobochang.watch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watch Studio",
        "width": 1160,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../src": "watch-core/src",
      "../../node_modules/tsx": "watch-core/node_modules/tsx",
      "../../node_modules/esbuild": "watch-core/node_modules/esbuild",
      "../../node_modules/@esbuild": "watch-core/node_modules/@esbuild"
    }
  }
}
