{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "relay.bobochang.cn",
      "custom_domain": true
    }
  ]
}
