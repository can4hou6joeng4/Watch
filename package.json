{
  "name": "watch",
  "version": "0.1.497",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "值更 · 跨 CLI 编程 Agent 会话接力台",
  "scripts": {
    "watch": "tsx src/cli.ts",
    "desktop:dev": "npm --prefix desktop run tauri -- dev",
    "typecheck": "tsc --noEmit",
    "validate:codex-native": "node scripts/validate-codex-native.mjs",
    "validate:opencode-native": "node --import tsx scripts/validate-opencode-native.mjs",
    "validate:opencode-server": "node --import tsx scripts/validate-opencode-server.mjs",
    "validate:opencode-client": "node scripts/run-opencode-validation-client.mjs",
    "site:preview": "node scripts/serve-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:locales": "node scripts/check-site-locales.mjs",
    "site:deploy": "node scripts/deploy-site.mjs",
    "site:indexnow": "node scripts/submit-indexnow.mjs",
    "trends:collect": "node scripts/collect-google-trends.mjs",
    "trends:analyze": "node scripts/analyze-google-trends.mjs",
    "trends:summarize": "node scripts/summarize-google-trends.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "validate:codex-writer-guard": "node --import tsx scripts/validate-codex-writer-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.12.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/can4hou6joeng4/Watch.git"
  },
  "homepage": "https://relay.bobochang.cn",
  "bugs": {
    "url": "https://github.com/can4hou6joeng4/Watch/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
