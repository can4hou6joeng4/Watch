{
  "name": "watch",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "值更 · 跨 CLI 编程 Agent 会话接力台",
  "scripts": {
    "watch": "tsx src/cli.ts",
    "desktop:dev": "npm --prefix desktop run tauri -- dev",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "validate:codex-native": "node scripts/validate-codex-native.mjs",
    "validate:opencode-native": "node --import tsx scripts/validate-opencode-native.mjs",
    "validate:opencode-server": "node --import tsx scripts/validate-opencode-server.mjs",
    "validate:opencode-client": "node scripts/run-opencode-validation-client.mjs",
    "site:preview": "node scripts/serve-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:deploy": "node scripts/deploy-site.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "validate:codex-writer-guard": "node --import tsx scripts/validate-codex-writer-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.131.1"
  }
}
